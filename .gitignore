# Credentials and local environments
.env
.venv/
env/
.vscode/
.idea/

# Local report-writing materials (kept on this machine)
/local-paper-materials/
/paper/key_facts.md
/paper/evidence_dossier.md

# Python build and cache files
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/
.ipynb_checkpoints/

# Data and model weights (fetched by scripts/prepare_data.py and scripts/download_models.py); only the fixed image
# lists are kept. outputs/ holds the committed per-image outputs of the original runs; new reruns and smoke tests go
# to the ignored subfolders below.
/data/*
!/data/splits/
/checkpoints
/outputs/rerun/
/outputs/smoke/
/results/smoke/
*.pth
*.pt
*.safetensors

# LaTeX build files (when the paper is compiled under paper/)
/paper/**/*.aux
/paper/**/*.log
/paper/**/*.out
/paper/**/*.bbl
/paper/**/*.blg
/paper/**/*.fls
/paper/**/*.fdb_latexmk
/paper/**/*.synctex.gz
