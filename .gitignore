# Credentials and local environments
.env
.venv/
env/
.vscode/
.idea/

# Python build and cache files
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/
.ipynb_checkpoints/

# Data, model weights and run outputs (regenerated by scripts/prepare_data.py, scripts/download_models.py and
# reproduce/full.sh); only the fixed image lists are kept
/data/*
!/data/splits/
/checkpoints
/outputs/
*.pth
*.pt
*.safetensors

# LaTeX build files and the third-party NeurIPS style file (when the paper is compiled under paper/)
/paper/**/*.aux
/paper/**/*.log
/paper/**/*.out
/paper/**/*.bbl
/paper/**/*.blg
/paper/**/*.fls
/paper/**/*.fdb_latexmk
/paper/**/*.synctex.gz
/paper/**/neurips_*.sty
